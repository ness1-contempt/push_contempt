<?xml version="1.0"?>
<!-- Test con WordPress e WooCommerce veri e un database di prova: vedi tests/Integration/bootstrap.php -->
<phpunit bootstrap="tests/Integration/bootstrap.php" colors="true">
    <testsuites>
        <testsuite name="integration">
            <directory suffix="Test.php">tests/Integration</directory>
        </testsuite>
    </testsuites>
</phpunit>
